# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Price IDs
STRIPE_PRICE_CAMPS=price_...
STRIPE_PRICE_TEAMS=price_...
STRIPE_PRICE_EKUZO100=price_...
STRIPE_PRICE_TEAMS_INSTALLMENTS=price_...

# Stripe webhook secret (set after deploying webhook endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Beehiiv ────────────────────────────────────────────────────────────────
BEEHIIV_API_KEY=...
BEEHIIV_PUBLICATION_ID=pub_...

# ─── Make.com ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WEBHOOK_URL=https://hook.us2.make.com/xl4bb6oyilsj8cugl8dgal5446a1jfj3

# ─── Meta (Pixel + Conversions API) ──────────────────────────────────────────
# Pixel ID — exposed to the browser for the client-side fbq init.
# Also read by the server-side CAPI handler so both surfaces share one source.
NEXT_PUBLIC_META_PIXEL_ID=1284038230557204
# Server-only. Generate at: Business Manager > Events Manager > Pixel >
# Settings > Conversions API > Generate access token. NEVER commit the token.
META_PIXEL_ID=1284038230557204
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
# Optional. When set (e.g. TEST12345 from Events Manager > Test Events tab), flags server CAPI events as test events so they appear in the Test Events viewer with browser-side dedup.
# Leave empty in production — Meta will reject events with stale test codes.

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3001
