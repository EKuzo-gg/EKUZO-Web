# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Price IDs
STRIPE_PRICE_CAMPS=price_...
STRIPE_PRICE_TEAMS=price_...
STRIPE_PRICE_EKUZO100=price_...
STRIPE_PRICE_TEAMS_INSTALLMENTS=price_...

# Stripe webhook secret (set after deploying webhook endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Beehiiv ────────────────────────────────────────────────────────────────
BEEHIIV_API_KEY=...
BEEHIIV_PUBLICATION_ID=pub_...

# ─── Make.com ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WEBHOOK_URL=https://hook.us2.make.com/xl4bb6oyilsj8cugl8dgal5446a1jfj3

# ─── Meta (Pixel + Conversions API) ──────────────────────────────────────────
# Pixel ID — exposed to the browser for the client-side fbq init.
# Server-side CAPI handler reads META_PIXEL_ID first, then falls back to
# NEXT_PUBLIC_META_PIXEL_ID, so setting only the public var is enough to
# keep both surfaces on a single source. Set META_PIXEL_ID separately only
# if the server should fire against a different pixel.
NEXT_PUBLIC_META_PIXEL_ID=1284038230557204
# Optional server override. If unset, server CAPI uses NEXT_PUBLIC_META_PIXEL_ID.
META_PIXEL_ID=1284038230557204
# Server-only. Generate at: Business Manager > Events Manager > Pixel >
# Settings > Conversions API > Generate access token. NEVER commit the token.
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
# Optional override for the auto-applied "TEST_AUTO" test_event_code on
# non-livemode CAPI fires. Useful if you want named test codes per
# environment (e.g. TEST12345 from Events Manager > Test Events tab).
# Leave empty in all contexts — production payments are detected via
# Stripe's livemode flag and never get tagged regardless of this var.

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ─── Microsoft Clarity ────────────────────────────────────────────────────────
# Free heatmap + session-recording. Project ID from
# clarity.microsoft.com → settings → install. Internal team IPs are blocked
# dashboard-side (clarity.microsoft.com → settings → IP blocking), not in code,
# so the same script tag runs for everyone — Clarity skips ingestion server-side
# for blocked IPs. Leave unset to disable the install entirely (the script tag
# is gated in app/layout.tsx).
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ─── Newsletter Popup ─────────────────────────────────────────────────────────
# Site-wide first-visit Beehiiv popup. Disabled by default — the component
# stays in the codebase but is unmounted in app/layout.tsx when this var is
# anything other than the literal string "true". Footer inline newsletter
# form is unaffected. Re-enable by setting to "true" in the appropriate
# Netlify env context (and redeploying — NEXT_PUBLIC_* vars are baked at
# build time, not read at runtime).
NEXT_PUBLIC_NEWSLETTER_POPUP_ENABLED=false
